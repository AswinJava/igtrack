{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/architecture.md", "docs/platform-limitations.md"],
  "snapshot": true,
  "watcher": {
    "ignore": ["node_modules", ".next", "dist", "coverage", "data", "storage"]
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "pnpm *": "allow",
      "npm run *": "allow",
      "npx vitest*": "allow",
      "docker compose *": "ask",
      "rm -rf *": "deny",
      "git push*": "ask",
      "*": "ask"
    },
    "external_directory": {
      "*": "ask"
    }
  }
}
