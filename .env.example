# IGTrack environment — copy to .env and fill in. NEVER commit .env.

# --- Database (Phase 2+) ---
# Local dev default matches docker-compose.yml
DATABASE_URL=postgresql://igtrack:igtrack@localhost:5432/igtrack
# Isolated test database (same container); used by `pnpm test` with real Postgres
IGTRACK_TEST_DATABASE_URL=postgresql://igtrack:igtrack@localhost:5432/igtrack_test

# --- Web app ---
IGTRACK_PORT=3000

# Dev login (/api/auth/dev-login) works in non-production builds and ALWAYS
# answers 404 in production builds — there is no opt-in override. Set false to
# disable it locally too:
# IGTRACK_ALLOW_DEV_LOGIN=false

# --- Media storage ---
# Local filesystem root for archived story media (MediaStorage interface abstracts this)
IGTRACK_MEDIA_DIR=./data/media

# --- Ingestion ---
# Active provider: fixture | (future pluggable providers)
# Only "fixture" is supported without explicit founder authorization.
# A future Graph API provider would be "graph" and requires ALL of the
# following — NEVER commit their values; they live in the environment or
# secret store, never in fixtures, evidence, logs, or the browser bundle:
#   IGTRACK_GRAPH_CLIENT_ID
#   IGTRACK_GRAPH_CLIENT_SECRET
#   IGTRACK_GRAPH_ACCESS_TOKEN  (long-lived user token, 60-day, refreshable after 24h)
#   IGTRACK_GRAPH_APP_ID
# See docs/phase-10-provider-evaluation.md §3 for the authorization model.
IGTRACK_PROVIDER=fixture
# Fixture set version under packages/ingestion/fixtures/
IGTRACK_FIXTURE_VERSION=v1

# --- Job system ---
# Poll interval for the database-backed job runner (ms)
IGTRACK_JOB_POLL_MS=5000
# Lease duration for a claimed job before another worker may reclaim it (ms).
# Should exceed the longest expected scan; there is no in-flight lease renewal.
IGTRACK_JOB_LEASE_MS=300000
# Provider call timeout (ms). A provider call that exceeds it fails as a
# typed retryable TIMEOUT — the worker never hangs on a stuck provider.
IGTRACK_PROVIDER_TIMEOUT_MS=30000

# --- Pool / wire timeouts (Phase 10 hardening) ---
# Postgres pool/wire bounds are baked into the client (connect 10s, idle 30s,
# lifetime 30m). Override only via DATABASE_URL query params if a deployment
# needs different bounds — no extra env indirection yet.

# --- Retention (worker maintenance tick, hourly) ---
# Expired sessions are purged automatically by the worker loop; terminal
# monitoring_jobs (succeeded/failed/cancelled) older than this are purged.
# Override only if a deployment needs different bounds.
# IGTRACK_JOBS_RETENTION_DAYS=90
# IGTRACK_MAINTENANCE_TICK_MS=3600000

# --- Rate limiting (Phase 10) ---
# Login rate limit is in-memory: 5 attempts per 15m per IP+email on
# POST /api/auth/login (429 + Retry-After). No env tuning yet; the limiter
# is single-instance and resets on restart (documented limitation).

# --- Notifications (adapters; fill when enabling) ---
# IGTRACK_SMTP_URL=
# IGTRACK_EMAIL_FROM=

# --- Observability ---
IGTRACK_LOG_LEVEL=info
