# IGTrack environment — copy to .env and fill in. NEVER commit .env.
#
# Release-gate configuration reference. For every variable:
# purpose / default / production requirement / safe range / failure behavior.
# Unset-but-required values fail fast at startup; out-of-range numerics fall
# back to defaults EXCEPT the worker boot guard (see Job system), which
# refuses to start on dangerous values.

# --- Database ---
# Primary connection string. REQUIRED in every runtime (worker, CLIs).
# No default: startup throws "Database URL is not configured" without it.
# Production: any Postgres 16+ URL with ?sslmode=require (SSL auto-enabled).
DATABASE_URL=postgresql://igtrack:igtrack@localhost:5432/igtrack
# Alias accepted everywhere DATABASE_URL is (checked second). Useful when a
# platform reserves the bare DATABASE_URL name for another service.
# IGTRACK_DATABASE_URL=
# Isolated test database (same container); used by `pnpm test` with real Postgres.
IGTRACK_TEST_DATABASE_URL=postgresql://igtrack:igtrack@localhost:5432/igtrack_test

# --- CLI ownership ---
# Which user owns CLI operations when the database holds more than one user.
# Precedence: an explicit --user flag, then this, then the only user.
# IGTRACK_USER_EMAIL=

# --- Media storage ---
# RESERVED, CURRENTLY UNREAD BY ANY RUNTIME PATH. Do not rely on it: story
# media bytes have no producer (metadata-only by policy until a provider
# supplies archivable URLs). Kept as the documented future home.
IGTRACK_MEDIA_DIR=./data/media

# --- Ingestion ---
# Active provider: fixture | graph | import. Default: fixture (synthetic).
# "fixture" is the default synthetic source. "graph" is the authorized live
# path: owned Business/Creator Instagram account + Meta app, reached ONLY
# through the official Instagram Graph API. It requires ALL of the following —
# NEVER commit their values; they live in the environment or secret store,
# never in fixtures, evidence, logs, or the browser bundle:
#   IGTRACK_GRAPH_ACCESS_TOKEN  (long-lived user token, 60-day, refreshable after 24h)
#   IGTRACK_GRAPH_IG_USER_ID    (scoped Instagram Business/Creator account id)
#   IGTRACK_GRAPH_USERNAME      (that account's username, for resolve matching)
#   IGTRACK_GRAPH_API_VERSION   (optional, default v21.0)
# "Are they set?" and "do they work?" are different questions, and only the
# first one can be answered without spending a request:
#   * `igtrack doctor` / `igtrack config` make NO network call. They report
#     MISSING, PLACEHOLDER, INVALID_CONFIGURATION or NOT_VERIFIED. PLACEHOLDER
#     catches the template text a fresh setup pastes — PASTE_..._HERE,
#     <YOUR_TOKEN>, xxxxxx — case-insensitively and ignoring surrounding
#     whitespace.
#   * A MISSING or PLACEHOLDER value is treated as absent: the provider
#     refuses to be built, `doctor` exits 3, and `lookup` / `targets add` fail
#     fast with "no API request was made". Presence is not validity.
#   * NOT_VERIFIED is the honest best a local check can do. A well-formed
#     token is still judged by the API, not by a heuristic.
#   * Live check: fill all three, then run a read-only
#     `igtrack lookup @<owned username>`. A 200 with your own profile is the
#     only proof; an expired token, a missing permission, or a consumer
#     (non-Business/Creator) account is an API-side fact no local check can
#     predict.
# Diagnostics print variable names and the fix — never a credential's value.
# By default the graph provider observes ONLY the authorized owned account;
# every other username resolves ACCOUNT_NOT_FOUND, and follower/following lists
# plus highlights/likes stay UNAVAILABLE because the Graph API does not expose
# them. Setting IGTRACK_GRAPH_BUSINESS_DISCOVERY=1 explicitly opts into the one
# documented route to ANOTHER account's public data (profile fields + a bounded
# recent-media preview, public Business/Creator accounts only — consumer and
# private accounts are unreachable, age-gated accounts return nothing). That
# route is a probe: `igtrack lookup` renders it and persists nothing. It still
# cannot deliver rosters, highlights, likers, or anyone's likes/comments on
# other accounts — see docs/FOUNDING.md §14 for why those stay refused.
# IGTRACK_GRAPH_BUSINESS_DISCOVERY=
# "import" reads the operator's OWN Instagram data export (JSON, "Download
# your information") — the only lawful source of a REAL follower/following
# roster. Requires BOTH:
#   IGTRACK_IMPORT_DIR       (export path: its root, connections/, or the
#                             connections/followers_and_following/ directory)
#   IGTRACK_IMPORT_USERNAME  (the export's owner — the only account observed)
# Out-of-roster capabilities (profile/stories/posts/comments) answer
# UNAVAILABLE with the reason, never zero; a missing dir/username fails fast,
# never UNAVAILABLE. Unknown provider names fail fast at startup (worker) /
# first use (CLI).
IGTRACK_PROVIDER=fixture
# Fixture set version under packages/ingestion/fixtures/. Default v1.
IGTRACK_FIXTURE_VERSION=v1
# Override the fixture directory (absolute path). Default: resolved from the
# package layout. Rarely needed; wrong paths fail as SOURCE_NOT_FOUND scans.
# IGTRACK_FIXTURES_DIR=

# --- Public-web research (the bounded acquisition engine, D69, D73) ---
# Search provider for `igtrack audit`'s web phase and `igtrack research --run`.
# A search returns CANDIDATE urls only — never evidence: every candidate still
# passes the SSRF gate, robots check, byte/timeout caps and the predicate
# registry before anything is said. Codes the report distinguishes:
#   SEARCH_NOT_CONFIGURED / SEARCH_SUCCEEDED / SEARCH_NO_RESULTS / SEARCH_FAILED.
#   auto     — Brave when IGTRACK_RESEARCH_SEARCH_API_KEY is set, otherwise the
#              keyless FreeSerp index. This is what a fresh install gets: a REAL
#              search with no account, no key and no meter.
#   brave    — the official Brave Search API only; requires the key below and
#              names the variable when it is empty (never a silent "no results").
#   freeserp — always the keyless FreeSerp index (documented JSON API over its
#              own crawl index; be reasonable: a few requests/second).
#   none     — never send a search request. The engine then researches only
#              operator --url pages and prior claim sources, and says so —
#              never a fabricated candidate list.
IGTRACK_RESEARCH_SEARCH_PROVIDER=auto
# Brave (or Brave-compatible) key. Only read with provider=brave or when auto
# should prefer Brave. NEVER commit a value; presence is not validity.
# IGTRACK_RESEARCH_SEARCH_API_KEY=
# Bounds are compile-time constants, deliberately NOT configurable here:
#   RESEARCH_MAX_SOURCES=10, RESEARCH_MAX_DEPTH=1, RESEARCH_FETCH_TIMEOUT_MS=10000,
#   RESEARCH_MAX_BYTES=524288 (512KB), RESEARCH_MAX_REDIRECTS=3,
#   RESEARCH_DOCUMENT_FRESH_HOURS=24 (document reuse window).
# An environment variable is a deployment choice; these are the product's
# safety envelope, pinned by tests (packages/core/test/research.test.ts).

# --- Job system (worker boot guard enforced, see below) ---
# Poll interval for the database-backed job runner (ms). Default 5000.
# Safe range: positive finite. 0/negative/NaN => worker REFUSES TO BOOT.
IGTRACK_JOB_POLL_MS=5000
# Lease duration for a claimed job before another worker may reclaim it (ms).
# Default 300000. Safe range: positive finite, comfortably above the longest
# single page-fetch (paged scans heartbeat per page, so the lease only needs
# to cover gaps between heartbeats, not whole scans).
# 0/negative/NaN => worker REFUSES TO BOOT (an instant-reclaim loop would
# duplicate every scan). Programmatic leaseMs: 0 remains available to tests.
IGTRACK_JOB_LEASE_MS=300000
# Provider call timeout (ms). Default 30000. Safe range: positive finite.
# 0/negative/NaN => worker REFUSES TO BOOT (every call would time out).
# A provider call that exceeds it fails as a typed retryable TIMEOUT.
IGTRACK_PROVIDER_TIMEOUT_MS=30000
# Ephemeral drain bound for --once runs (jobs per invocation). Default 25.
# Safe range: positive integer. Only read with --once / IGTRACK_WORKER_ONCE=1.
# IGTRACK_JOB_MAX_ITER=25
# Set to 1 to run the worker as a bounded one-shot (used by GitHub Actions
# ephemeral runs). Unset/empty => long-running daemon.
# IGTRACK_WORKER_ONCE=
# --- Follow scan termination bound ---
# Most pages a single FOLLOWER/FOLLOWING scan reads before it stops. Default
# 500. A repeating cursor is caught by the loop guard; a cursor that mints a
# brand-new value every page is not a loop anyone can detect, so this cap is
# what keeps such a provider from fetching until killed. Not a boot-guard value:
# unset/invalid falls back to 500. A capped scan stores PARTIAL and records the
# cap in its evidence (pageCap) — it never claims COMPLETE, and never claims the
# unread remainder does not exist. Raise it for a legitimately huge roster.
# Safe range: positive integer.
# IGTRACK_FOLLOW_MAX_PAGES=500
# --- Scan cadence (ms per kind; stories poll faster because they expire) ---
# Override any of these to trade freshness against provider load. Unset or
# invalid values fall back to the defaults (stories 30m, everything else 6h).
# A missed story poll is a permanent ephemerality gap — stories live 24h.
# IGTRACK_SCAN_STORY_MS=1800000
# IGTRACK_SCAN_PROFILE_MS=21600000
# IGTRACK_SCAN_FOLLOWERS_MS=21600000
# IGTRACK_SCAN_FOLLOWING_MS=21600000
# IGTRACK_SCAN_POSTS_MS=21600000
# Insights move slowly but their windows are perishable (metrics lag up to
# 48h; the platform keeps ~90 days). Capturing early is the whole value.
# IGTRACK_SCAN_INSIGHTS_MS=21600000
# Tagged media and the one cross-account discovery scan are daily: another
# account's footprint moves slowly, and discovery spends the shared
# Platform Rate Limit budget (200 x users per hour).
# IGTRACK_SCAN_TAGS_MS=86400000
# IGTRACK_SCAN_DISCOVERY_MS=86400000

# --- Scheduler ---
# Master switch. Default enabled; set exactly "false" to disable ticking
# (queue still drains manually enqueued jobs). Safe in all values.
# IGTRACK_SCHEDULER_ENABLED=
# Tick interval (ms). Default 60000. Safe range: positive finite.
# 0/negative/NaN => worker REFUSES TO BOOT (tick loop would hot-spin).
# IGTRACK_SCHEDULER_TICK_MS=60000
# Max targets considered per tick (fleet rotation covers the rest on later
# ticks). Default 200. Invalid values fall back to 200 (tolerant, not fatal).
# IGTRACK_SCHEDULER_BATCH=200

# --- Pool / wire timeouts (Phase 10 hardening) ---
# Postgres pool/wire bounds are baked into the client (connect 10s, idle 30s,
# lifetime 30m). Override only via DATABASE_URL query params if a deployment
# needs different bounds — no extra env indirection yet.

# --- Retention (worker maintenance tick, hourly) ---
# Terminal monitoring_jobs (succeeded/failed/cancelled) older than this are
# purged. Default 90 days. Invalid values fall back to 90 (never to unbounded
# growth).
# IGTRACK_JOBS_RETENTION_DAYS=90
# Maintenance cadence (ms). Default 3600000. Invalid values keep the default.
# IGTRACK_MAINTENANCE_TICK_MS=3600000

# --- Notifications (no adapters implemented; reserved names only) ---
# IGTRACK_SMTP_URL=
# IGTRACK_EMAIL_FROM=

# --- Observability ---
# RESERVED, CURRENTLY UNREAD. Worker logs are JSON lines at info level
# today; there is no level filter yet. Do not set expecting quieter logs.
IGTRACK_LOG_LEVEL=info
