# IGTrack environment — copy to .env and fill in. NEVER commit .env.
#
# Release-gate configuration reference. For every variable:
# purpose / default / production requirement / safe range / failure behavior.
# Unset-but-required values fail fast at startup; out-of-range numerics fall
# back to defaults EXCEPT the worker boot guard (see Job system), which
# refuses to start on dangerous values.

# --- Database ---
# Primary connection string. REQUIRED in every runtime (web, worker, CLIs).
# No default: startup throws "Database URL is not configured" without it.
# Production: Neon Postgres URL with ?sslmode=require (SSL auto-enabled).
DATABASE_URL=postgresql://igtrack:igtrack@localhost:5432/igtrack
# Alias accepted everywhere DATABASE_URL is (checked second). Useful when a
# platform reserves the bare DATABASE_URL name for another service.
# IGTRACK_DATABASE_URL=
# Isolated test database (same container); used by `pnpm test` with real Postgres.
IGTRACK_TEST_DATABASE_URL=postgresql://igtrack:igtrack@localhost:5432/igtrack_test

# --- Web app ---
# Port the web process listens on (Docker CMD / compose mapping).
# Default 3000. Safe range: any free port. Ignored on Render (uses $PORT).
IGTRACK_PORT=3000
# Base URL used for post-login/logout redirects. Default: request origin.
# Production: set to the public origin (e.g. https://igtrack.example.com)
# so redirects never inherit a forwarded host.
# NEXT_PUBLIC_BASE_URL=

# Dev login (/api/auth/dev-login) works in non-production builds and ALWAYS
# answers 404 in production builds — there is no opt-in override. Set false to
# disable it locally too:
# IGTRACK_ALLOW_DEV_LOGIN=false

# --- Media storage ---
# RESERVED, CURRENTLY UNREAD BY ANY RUNTIME PATH. Do not rely on it: story
# media bytes have no producer (metadata-only by policy until a provider
# supplies archivable URLs). Kept as the documented future home.
IGTRACK_MEDIA_DIR=./data/media

# --- Ingestion ---
# Active provider: fixture | graph. Default: fixture (synthetic).
# "fixture" is the default synthetic source. "graph" is the authorized live
# path: owned Business/Creator Instagram account + Meta app, reached ONLY
# through the official Instagram Graph API. It requires ALL of the following —
# NEVER commit their values; they live in the environment or secret store,
# never in fixtures, evidence, logs, or the browser bundle:
#   IGTRACK_GRAPH_ACCESS_TOKEN  (long-lived user token, 60-day, refreshable after 24h)
#   IGTRACK_GRAPH_IG_USER_ID    (scoped Instagram Business/Creator account id)
#   IGTRACK_GRAPH_USERNAME      (that account's username, for resolve matching)
#   IGTRACK_GRAPH_API_VERSION   (optional, default v21.0)
# The graph provider observes ONLY the authorized owned account; every other
# username resolves ACCOUNT_NOT_FOUND, and follower/following lists plus
# highlights/likes stay UNAVAILABLE because the Graph API does not expose them.
# Unknown provider names fail fast at startup (worker) / first use (web).
IGTRACK_PROVIDER=fixture
# Fixture set version under packages/ingestion/fixtures/. Default v1.
IGTRACK_FIXTURE_VERSION=v1
# Override the fixture directory (absolute path). Default: resolved from the
# package layout. Rarely needed; wrong paths fail as SOURCE_NOT_FOUND scans.
# IGTRACK_FIXTURES_DIR=

# --- Job system (worker boot guard enforced, see below) ---
# Poll interval for the database-backed job runner (ms). Default 5000.
# Safe range: positive finite. 0/negative/NaN => worker REFUSES TO BOOT.
IGTRACK_JOB_POLL_MS=5000
# Lease duration for a claimed job before another worker may reclaim it (ms).
# Default 300000. Safe range: positive finite, comfortably above the longest
# single page-fetch (paged scans heartbeat per page, so the lease only needs
# to cover gaps between heartbeats, not whole scans).
# 0/negative/NaN => worker REFUSES TO BOOT (an instant-reclaim loop would
# duplicate every scan). Programmatic leaseMs: 0 remains available to tests.
IGTRACK_JOB_LEASE_MS=300000
# Provider call timeout (ms). Default 30000. Safe range: positive finite.
# 0/negative/NaN => worker REFUSES TO BOOT (every call would time out).
# A provider call that exceeds it fails as a typed retryable TIMEOUT.
IGTRACK_PROVIDER_TIMEOUT_MS=30000
# Ephemeral drain bound for --once runs (jobs per invocation). Default 25.
# Safe range: positive integer. Only read with --once / IGTRACK_WORKER_ONCE=1.
# IGTRACK_JOB_MAX_ITER=25
# Set to 1 to run the worker as a bounded one-shot (used by GitHub Actions
# ephemeral runs and release E2E). Unset/empty => long-running daemon.
# IGTRACK_WORKER_ONCE=
# --- Scan cadence (ms per kind; stories poll faster because they expire) ---
# Override any of these to trade freshness against provider load. Unset or
# invalid values fall back to the defaults (stories 30m, everything else 6h).
# A missed story poll is a permanent ephemerality gap — stories live 24h.
# IGTRACK_SCAN_STORY_MS=1800000
# IGTRACK_SCAN_PROFILE_MS=21600000
# IGTRACK_SCAN_FOLLOWERS_MS=21600000
# IGTRACK_SCAN_FOLLOWING_MS=21600000
# IGTRACK_SCAN_POSTS_MS=21600000

# --- Scheduler ---
# Master switch. Default enabled; set exactly "false" to disable ticking
# (queue still drains manually enqueued jobs). Safe in all values.
# IGTRACK_SCHEDULER_ENABLED=
# Tick interval (ms). Default 60000. Safe range: positive finite.
# 0/negative/NaN => worker REFUSES TO BOOT (tick loop would hot-spin).
# IGTRACK_SCHEDULER_TICK_MS=60000
# Max targets considered per tick (fleet rotation covers the rest on later
# ticks). Default 200. Invalid values fall back to 200 (tolerant, not fatal).
# IGTRACK_SCHEDULER_BATCH=200

# --- Pool / wire timeouts (Phase 10 hardening) ---
# Postgres pool/wire bounds are baked into the client (connect 10s, idle 30s,
# lifetime 30m). Override only via DATABASE_URL query params if a deployment
# needs different bounds — no extra env indirection yet.

# --- Retention (worker maintenance tick, hourly) ---
# Expired sessions are purged automatically by the worker loop; terminal
# monitoring_jobs (succeeded/failed/cancelled) older than this are purged.
# Default 90 days. Invalid values fall back to 90 (never to unbounded growth).
# IGTRACK_JOBS_RETENTION_DAYS=90
# Maintenance cadence (ms). Default 3600000. Invalid values keep the default.
# IGTRACK_MAINTENANCE_TICK_MS=3600000

# --- Rate limiting (Phase 10 login, Phase 15 mutations) ---
# Login rate limit is in-memory: 5 attempts per 15m per IP+email on
# POST /api/auth/login (429 + Retry-After). Target mutations (create/update/
# delete/pause/resume) share the same single-process limiter at 60 per minute
# per user. No env tuning yet; the limiter is single-process and resets on
# restart (documented limitation — never claim distributed protection).
# Horizontal path: implement the RateLimiter seam in apps/web/lib/rate-limit.ts
# against a shared store; no call-site changes needed.

# --- Notifications (no adapters implemented; reserved names only) ---
# IGTRACK_SMTP_URL=
# IGTRACK_EMAIL_FROM=

# --- Observability ---
# RESERVED, CURRENTLY UNREAD. Worker/web logs are JSON lines at info level
# today; there is no level filter yet. Do not set expecting quieter logs.
IGTRACK_LOG_LEVEL=info
