# IGTrack worker — job runner + scheduler (self-host beta)
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.21.0 --activate
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/core/package.json packages/core/package.json
COPY packages/ingestion/package.json packages/ingestion/package.json
COPY packages/database/package.json packages/database/package.json
COPY apps/web/package.json apps/web/package.json
COPY workers/monitoring/package.json workers/monitoring/package.json
# tsx is needed at runtime (worker start uses tsx) — ensure it is installed
COPY tsconfig.base.json tsconfig.base.json
COPY packages/core packages/core
COPY packages/ingestion packages/ingestion
COPY packages/database packages/database
COPY workers/monitoring workers/monitoring
RUN pnpm install --frozen-lockfile
# No build step — worker runs via tsx (keeps source maps, no extra compile)
# Verify it at least typechecks in the image build
RUN pnpm --filter @igtrack/monitoring typecheck

FROM node:22-alpine AS runner
RUN addgroup -S igtrack && adduser -S igtrack -G igtrack
RUN corepack enable && corepack prepare pnpm@11.21.0 --activate
WORKDIR /app
ENV NODE_ENV=production
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/package.json ./package.json
COPY --from=base /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=base /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=base /app/tsconfig.base.json ./tsconfig.base.json
COPY --from=base /app/packages ./packages
COPY --from=base /app/workers ./workers
USER igtrack
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD pgrep -f "workers/monitoring" >/dev/null || exit 1
CMD ["pnpm","--filter","@igtrack/monitoring","start"]
