{
  "name": "igtrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Evidence-driven public Instagram monitoring and relationship intelligence platform",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "verify:graph": "pnpm exec tsx scripts/verify-graph-provider.ts",
    "docs:capabilities": "pnpm exec tsx scripts/capability-matrix.ts",
    "igtrack": "pnpm --filter @igtrack/cli run start",
    "mcp": "pnpm --filter @igtrack/cli run start mcp",
    "worker": "pnpm --filter @igtrack/monitoring start"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
