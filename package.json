{
  "name": "igtrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Evidence-driven public Instagram monitoring and relationship intelligence platform",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "verify:graph": "pnpm exec tsx scripts/verify-graph-provider.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
